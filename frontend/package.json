{
  "name": "gamers-den-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run.mjs next dev",
    "build": "node scripts/run.mjs next build",
    "start": "node scripts/run.mjs next start",
    "typecheck": "tsc --noEmit",
    "types:gen": "node scripts/generate-api-types.mjs",
    "types:check": "node scripts/generate-api-types.mjs --check",
    "test": "node scripts/run.mjs vitest run",
    "test:watch": "node scripts/run.mjs vitest",
    "e2e": "node scripts/e2e.mjs",
    "e2e:ui": "node scripts/e2e.mjs --ui",
    "e2e:install": "node scripts/run.mjs playwright install chromium",
    "e2e:reset": "docker compose -f ../backend/docker-compose.yml down -v && docker compose -f ../backend/docker-compose.yml up -d"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.39.0",
    "next": "^15.5.25",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.1.13",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.18.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "jsdom": "26.1.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
